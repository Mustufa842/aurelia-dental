# Copy this file to .env and fill in what you need.
# The site works out of the box with no .env at all (Dr. AI runs on
# built-in rules and bookings save to data/bookings.json).

# Port the server listens on (Cloud Run sets this automatically — leave unset there)
PORT=3000

# Comma-separated list of allowed frontend origins, e.g. your Cloudflare
# Pages URL. Leave blank/unset to allow all origins.
CORS_ORIGIN=

# Key required to view/manage bookings via GET/PATCH /api/bookings
# (sent as header: x-admin-key)
ADMIN_KEY=aurelia-admin

# Optional: add a real Anthropic API key to make Dr. AI answer with
# live Claude responses instead of the built-in rule-based replies.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
